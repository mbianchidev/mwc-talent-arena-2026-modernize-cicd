<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>TelcoRec Invoice Reconciliator</display-name>

    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!-- JAX-RS endpoint is registered via @ApplicationPath("/api") in ApplicationConfig.java.
         Do NOT add a servlet mapping here — it causes a duplicate endpoint error in TomEE/CXF. -->

    <resource-ref>
        <description>ReconciliatorDS H2 embedded database</description>
        <res-ref-name>jdbc/ReconciliatorDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

</web-app>
